<Project>

  <!--
    Общие настройки сборки для всех проектов решения.

    Библиотека намеренно таргетирует в том числе net6.0 и net7.0: часть продуктов,
    которые её используют, ещё не портирована на актуальные платформы, а поиск в них
    должен работать. Платформы сняты с поддержки Microsoft, поэтому SDK выдаёт
    предупреждение NETSDK1138. Это ожидаемо и сознательно, поэтому проверка EOL-платформ
    отключена, чтобы предупреждение не зашумляло сборку.
  -->
  <PropertyGroup>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

</Project>
