{
  "SearchEngineService": {
    "MaxDocumentCount": 100000,
    "MaxDocumentTextLength": 10000,
    "Snapshot": {
      "IsEnabled": false,
      "AutoRestoreOnStart": false,
      "FilePath": "data/search-index-snapshot.json"
    },
    "Sources": {},
    "Limits": {
      "MaxRequestBodyBytes": 33554432,
      "RateLimit": {
        "IsEnabled": true,
        "PermitLimit": 240,
        "WindowSeconds": 1,
        "QueueLimit": 0
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}